[Unit]
Description=pilauncher display shell
After=pilauncher.service
Requires=pilauncher.service
PartOf=graphical-session.target

[Service]
Environment=WAYLAND_DISPLAY=wayland-0
Environment=XDG_SESSION_TYPE=wayland
# Wait for the daemon to answer rather than sleeping a fixed interval.
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do curl -fsS -o /dev/null http://127.0.0.1:__PILAUNCHER_PORT__/status && exit 0; sleep 1; done; echo "daemon never came up" >&2; exit 1'
# --password-store=basic matches COMMON_FLAGS in launcher.py. Without it
# Chromium asks the Secret Service for a key, and with autologin the login
# keyring is never unlocked, so every boot raises an Unlock Keyring prompt.
ExecStart=/usr/bin/chromium --kiosk --noerrdialogs --password-store=basic --disable-infobars --disable-session-crashed-bubble --user-data-dir=%h/.local/share/pilauncher/shell http://127.0.0.1:__PILAUNCHER_PORT__
Restart=always
RestartSec=3

[Install]
WantedBy=default.target

.env
.env.*
!.env.example

__pycache__/
*.pyc

# Local browser profiles, if you ever test the daemon on the workstation
.local/
profiles/
shell/

# Service logos are trademarked brand assets and are fetched per machine into
# ~/.local/share/pilauncher/logos, never committed. This catches one dropped
# into the repo root by mistake on its way to the Pi.
*.svg
*.png
*.webp
*.jpg
*.jpeg


# Predecessor LineageOS ROM, Magisk, gapps and widevine zips (~1GB). Kept for
# reference, never part of the launcher.
Lineage/

# Sideloaded Android packages staged for Waydroid. Large, and not source.
*.apk
*.apkm
*.xapk
